# Outputs written by the existing renderer. Existing tracked examples remain tracked.
/runtime/artifacts/*.bmp
/runtime/artifacts/*.mp4
/runtime/jobs/

# A video render currently recreates this exact numbered sequence.
/frames/frame_[0-9][0-9][0-9][0-9].bmp

# Local validation caches.
__pycache__/
*.py[cod]

# Native out-of-source build trees.
/build/
